# Example users file. Copy to /etc/authelia/users_database.yml and replace
# PASSWORD_HASH with a real argon2id hash generated by:
#   authelia crypto hash generate --password '<password>'
# Never commit a real hash for a real password.
users:
  tony:
    displayname: Tony
    password: "PASSWORD_HASH"
    email: tlopez0620@gmail.com
    groups:
      - admins
